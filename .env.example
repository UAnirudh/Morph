# ---------------------------------------------------------------------------
# Morph environment template. Copy to .env.local and adjust.
# The app runs with ZERO configuration: it defaults to the local SQLite
# database and the deterministic local Morph planner.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local / self-hosted SQLite file (default). Created automatically on boot.
MORPH_DB_PATH=./data/morph.db

# Hosted Postgres (Supabase) connection string. Optional — see
# docs/DEPLOYMENT.md for the migration path and RLS policies.
# DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# --- Auth -----------------------------------------------------------------
# Used to sign session cookies and to rate-limit AI requests per user.
MORPH_SESSION_SECRET=change-me-to-a-long-random-string
# Optional: disable public signup on a shared demo deployment.
MORPH_ALLOW_SIGNUP=true

# --- AI provider ----------------------------------------------------------
# Without a key, Morph uses its deterministic local planner and says so in the
# UI ("Local planner"). With a key, live model generation is used and labelled
# with the model name.
# OPENAI_API_KEY=sk-...
MORPH_AI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible endpoint (Azure, OpenRouter, ...).
# MORPH_AI_BASE_URL=https://api.openai.com/v1

# --- Scheduler ------------------------------------------------------------
# When set, POST /api/workflows/run requires `Authorization: Bearer <secret>`
# and runs every workspace's enabled daily-check workflows.
# MORPH_CRON_SECRET=change-me-too

# --- Demo -----------------------------------------------------------------
# Password for the seeded demo account (demo@morph.app).
MORPH_DEMO_PASSWORD=morph-demo

# --- Supabase (optional, hosted deployment only) --------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never in the browser bundle
