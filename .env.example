# ---------------------------------------------------------------------------
# Morph environment template. Copy to .env.local and adjust.
#
# Local development needs ZERO configuration: it defaults to a local libSQL
# file and the deterministic local Morph planner.
#
# On Vercel, a local file cannot persist between requests, so a hosted database
# is required (see below) and every value belongs in Project → Settings →
# Environment Variables.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local development (default). Created automatically on boot.
MORPH_DB_PATH=./data/morph.db

# Hosted libSQL / Turso — REQUIRED on Vercel.
# Get both values with:
#   turso db create morph
#   turso db show morph --url
#   turso db tokens create morph
# TURSO_DATABASE_URL=libsql://morph-your-org.turso.io
# TURSO_AUTH_TOKEN=

# --- AI provider ----------------------------------------------------------
# Morph speaks the OpenAI chat-completions protocol, so Groq and OpenAI both
# work through one client. Resolution order:
#   1. MORPH_AI_PROVIDER=openai|groq (optional, forces one)
#   2. OPENAI_API_KEY
#   3. GROQ_API_KEY
# With neither key the deterministic local planner is used and the UI says so.

# Start here: free tier, no card. https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Later, when funded: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Optional overrides. MODEL must be a model the chosen provider serves:
#   Groq   → openai/gpt-oss-120b (default), openai/gpt-oss-20b
#   OpenAI → gpt-4o-mini (default), gpt-4o, o4-mini, ...
# MORPH_AI_MODEL=openai/gpt-oss-120b
# MORPH_AI_BASE_URL=https://api.groq.com/openai/v1

# --- Auth -----------------------------------------------------------------
# No signing secret is needed: sessions are random 256-bit tokens stored hashed
# in the database. Optional: disable public signup on a shared demo deployment.
MORPH_ALLOW_SIGNUP=true

# --- Scheduler ------------------------------------------------------------
# Daily workflows run through GET/POST /api/workflows/run. On Vercel, create a
# cron by setting this secret (Vercel sends it as `Authorization: Bearer ...`),
# or reuse Vercel's own CRON_SECRET name — either is accepted.
# MORPH_CRON_SECRET=change-me-too

# --- Demo -----------------------------------------------------------------
# Password for the seeded demo account (demo@morph.app).
MORPH_DEMO_PASSWORD=morph-demo
